{
  "mcpServers": {
    "adk-harness": {
      "title": "ADK Harness",
      "description": "Policy-gated Google Workspace and agent harness tools.",
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--from",
        "adk-harness[google-workspace] @ git+https://github.com/Davedat-110105/adk-harness.git@e2561c0972782564957d8bf593a444a17fc1b570",
        "adk-harness",
        "serve"
      ],
      "cwd": ".",
      "env_vars": [
        "GOOGLE_APPLICATION_CREDENTIALS",
        "GOOGLE_CLOUD_PROJECT",
        "ADK_SERVICES",
        "ADK_TOOLS",
        "ADK_LEDGER",
        "ADK_HARNESSES",
        "ADK_ALLOWED_DOMAINS"
      ]
    }
  }
}
